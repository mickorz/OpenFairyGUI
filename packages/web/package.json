{
	"name": "@openfairygui/web",
	"version": "0.1.1",
	"description": "FairyGUI Headless Authoring SDK -- web GUI.",
	"author": "OpenFairyGUI Contributors",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/OpenFairyGUI/OpenFairyGUI.git",
		"directory": "packages/web"
	},
	"type": "module",
	"bin": {
		"ofgui-web": "bin/ofgui-web.cjs"
	},
	"scripts": {
		"dev": "tsx --watch src/server.ts",
		"start": "node bin/ofgui-web.cjs",
		"build": "tsdown src/server.ts --format esm --platform node --no-dts --external sharp"
	},
	"files": [
		"dist/",
		"bin/",
		"src/client/"
	],
	"keywords": [
		"fairygui",
		"web",
		"gui",
		"publish",
		"restore"
	],
	"devDependencies": {
		"@openfairygui/core": "workspace:*",
		"@openfairygui/functions": "workspace:*"
	},
	"optionalDependencies": {
		"sharp": ">=0.33.0"
	}
}
